{
  "name": "@rsw/mc-bedrock-render-ts",
  "version": "1.6.1",
  "license": "CC-BY-NC-SA-4.0",
  "description": "TypeScript SDK for Minecraft: Bedrock Edition .mcstructure files: 3D rendering, materials, containers, redstone, entities and camera (same API and rendering stack as @rsw/mc-java-render-ts)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./mesh": {
      "types": "./dist/mesh/core/index.d.ts",
      "import": "./dist/mesh/core/index.js"
    },
    "./mesh/worker": {
      "types": "./dist/mesh/worker/index.d.ts",
      "import": "./dist/mesh/worker/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "example"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --all && tsc -p tsconfig.json --emitDeclarationOnly",
    "build:sdk": "node scripts/build.mjs --sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:consumer": "tsc --ignoreConfig --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --noEmit tests/public-api.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:all": "pnpm run build && pnpm run typecheck:consumer && pnpm test",
    "api:extract-java": "node scripts/extract-java-api.mjs",
    "data:import-holoprint": "node scripts/import-holoprint-data.mjs",
    "test:e2e": "tsx tests/gen-integ.ts && node tests/e2e/workshop.e2e.mjs && node tests/e2e/example.e2e.mjs",
    "coverage:blocks": "tsx tests/coverage.ts",
    "bench:mesh": "node --expose-gc node_modules/tsx/dist/cli.mjs tests/bench-mesh.ts",
    "dev:example": "pnpm run build && vite example --config example/vite.config.js",
    "build:example": "vite build example --config example/vite.config.js",
    "pack:resources": "tsx scripts/pack-resources.ts",
    "schematics:coverage": "tsx scripts/generate-coverage-structures.ts",
    "pack:list-official": "tsx scripts/list-official-pack.ts"
  },
  "sideEffects": false,
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": ">=5.6.0",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "vite": "8.3.5",
    "@playwright/test": "1.62.0",
    "postprocessing": "6.39.6",
    "n8ao": "1.10.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
